from rdflib import Graph, RDF, RDFS, OWL, URIRef, Literal
from collections import defaultdict

OWL_FILE = "myMenu.rdf"  # change this to your file
FORMAT = "xml"  # or "turtle" if your file is TTL

g = Graph()
g.parse(OWL_FILE, format=FORMAT)

# Get all declared classes
all_classes = set()
for s in g.subjects(RDF.type, OWL.Class):
    class_name = s.split("#")[-1]
    all_classes.add(class_name)

# Get individuals and group by class
class_slots = defaultdict(set)
instances = defaultdict(list)

for s, p, o in g:
    if (p == RDF.type) and (o != OWL.Class) and (o != RDFS.Class):
        if isinstance(o, URIRef):
            class_name = o.split("#")[-1]
            instance_name = s.split("#")[-1] if "#" in s else str(s)
            instances[class_name].append((instance_name, s))

    # If it's a data property
    if isinstance(s, URIRef) and isinstance(p, URIRef) and isinstance(o, Literal):
        # Try to find the class of the subject
        for t in g.objects(s, RDF.type):
            if t != OWL.NamedIndividual:
                class_name = t.split("#")[-1]
                prop_name = p.split("#")[-1]
                class_slots[class_name].add(prop_name)

# Generate CLIPS code
clips_code = []

# Ensure even empty classes are included
all_classes.update(class_slots.keys())
all_classes.update(instances.keys())

# Define templates
for cls in sorted(all_classes):
    clips_code.append(f"(deftemplate {cls}")
    for slot in sorted(class_slots.get(cls, [])):
        clips_code.append(f"   (slot {slot})")
    clips_code.append(")\n")

# Assert instances
for cls, indivs in instances.items():
    for name, uri in indivs:
        fact = f"({cls}"
        for p, o in g.predicate_objects(subject=uri):
            if isinstance(o, Literal):
                slot = p.split("#")[-1]
                val = str(o)
                val = f"\"{val}\"" if " " in val or not val.isalnum() else val
                fact += f" ({slot} {val})"
        fact += ")"
        clips_code.append(f"(assert {fact})\n")

# Save output
with open("ontology.clp", "w", encoding="utf-8") as f:
    f.write("\n".join(clips_code))

print("✅ CLIPS code generated: ontology.clp")
